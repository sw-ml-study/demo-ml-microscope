#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

for path in AGENTS.md COPYRIGHT LICENSE README.md catalog/lessons.toml justfile \
    docs/architecture.md docs/cross-repo-handoffs.md docs/plan.md \
    docs/graphics-options.md docs/linear-regression-microscope.md \
    docs/matrix-microscope.md docs/observation-contract.md docs/research.txt docs/sagas.md \
    docs/sw-mlpl-blockers.md mlplunit.conf; do
    if [ ! -f "$repo_dir/$path" ]; then
        echo "missing required file: $path" >&2
        exit 1
    fi
done

cmp -s "$repo_dir/COPYRIGHT" "$repo_dir/../demo-mlpl-libraries/COPYRIGHT" || {
    echo "COPYRIGHT differs from peer repository" >&2
    exit 1
}
cmp -s "$repo_dir/LICENSE" "$repo_dir/../demo-mlpl-libraries/LICENSE" || {
    echo "LICENSE differs from peer repository" >&2
    exit 1
}

grep -q 'agentrail:global:start' "$repo_dir/AGENTS.md"
grep -q 'Distributed under the \[MIT License\](LICENSE)' "$repo_dir/README.md"
