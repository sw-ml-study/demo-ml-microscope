#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
server=$($repo_root/scripts/select-mlpl-serve)
port=${MICROSCOPE_TEST_PORT:-16483}
base_url="http://127.0.0.1:$port"
log_file=$(mktemp)
response_file=$(mktemp)

cleanup() {
    if [ -n "${server_pid:-}" ]; then
        kill "$server_pid" 2>/dev/null || true
        wait "$server_pid" 2>/dev/null || true
    fi
    rm -f "$log_file" "$response_file"
}
trap cleanup EXIT HUP INT TERM

command -v curl >/dev/null 2>&1 || { echo "curl is required for the SSE probe" >&2; exit 1; }
command -v jq >/dev/null 2>&1 || { echo "jq is required for the SSE probe" >&2; exit 1; }

"$server" --bind "127.0.0.1:$port" --auth disabled >"$log_file" 2>&1 &
server_pid=$!

attempt=0
until curl --fail --silent "$base_url/v1/health" >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 50 ] || ! kill -0 "$server_pid" 2>/dev/null; then
        echo "mlpl-serve did not become ready" >&2
        sed -n '1,20p' "$log_file" >&2
        exit 1
    fi
done

session=$(curl --fail --silent --request POST "$base_url/v1/sessions")
session_id=$(printf '%s' "$session" | jq -r '.session_id')
token=$(printf '%s' "$session" | jq -r '.token')
program='emit_frame("phase/input", 0, [1, 2]); emit_frame("phase/weights", 0, [[1, 2], [3, 4]]); emit_frame("phase/output", 1, [[[5]], [[6]]])'
body=$(jq -nc --arg program "$program" '{program: $program}')

curl --fail --silent --no-buffer \
    --header "Authorization: Bearer $token" \
    --header 'Content-Type: application/json' \
    --data "$body" \
    "$base_url/v1/sessions/$session_id/eval_stream" >"$response_file"

events=$(sed -n 's/^event: *//p' "$response_file" | tr '\n' ' ')
if [ "$events" != "ready frame frame frame done " ]; then
    echo "unexpected SSE event order: $events" >&2
    sed -n '1,40p' "$response_file" >&2
    exit 1
fi

frames=$(sed -n 's/^data: *//p' "$response_file" | jq -c 'select(.name != null)')
count=$(printf '%s\n' "$frames" | grep -c '^{' || true)
[ "$count" -eq 3 ] || { echo "expected three frame payloads, got $count" >&2; exit 1; }

first=$(printf '%s\n' "$frames" | sed -n '1p')
second=$(printf '%s\n' "$frames" | sed -n '2p')
third=$(printf '%s\n' "$frames" | sed -n '3p')
[ "$(printf '%s' "$first" | jq -c '[.name,.step,.shape,.values]')" = '["phase/input",0,[2],[1.0,2.0]]' ]
[ "$(printf '%s' "$second" | jq -c '[.name,.step,.shape,.values]')" = '["phase/weights",0,[2,2],[1.0,2.0,3.0,4.0]]' ]
[ "$(printf '%s' "$third" | jq -c '[.name,.step,.shape,.values]')" = '["phase/output",1,[2,1,1],[5.0,6.0]]' ]

echo "PASS emit_frame SSE preserves call order, names, steps, shapes, and values"
