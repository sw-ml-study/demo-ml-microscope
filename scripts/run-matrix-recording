#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
server=$($repo_root/scripts/select-mlpl-serve)
fixture="$repo_root/fixtures/yew/matrix-run-v0.json"
port=${MICROSCOPE_MATRIX_PORT:-16484}
base_url="http://127.0.0.1:$port"
log_file=$(mktemp)
response_file=$(mktemp)

cleanup() {
    if [ -n "${server_pid:-}" ]; then
        kill "$server_pid" 2>/dev/null || true
        wait "$server_pid" 2>/dev/null || true
    fi
    rm -f "$log_file" "$response_file"
}
trap cleanup EXIT HUP INT TERM

command -v curl >/dev/null 2>&1 || { echo "curl is required" >&2; exit 1; }
command -v jq >/dev/null 2>&1 || { echo "jq is required" >&2; exit 1; }

"$server" --bind "127.0.0.1:$port" --auth disabled >"$log_file" 2>&1 &
server_pid=$!
attempt=0
until curl --fail --silent "$base_url/v1/health" >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 50 ] || ! kill -0 "$server_pid" 2>/dev/null; then
        echo "mlpl-serve did not become ready" >&2
        sed -n '1,20p' "$log_file" >&2
        exit 1
    fi
done

session=$(curl --fail --silent --request POST "$base_url/v1/sessions")
session_id=$(printf '%s' "$session" | jq -r '.session_id')
token=$(printf '%s' "$session" | jq -r '.token')
body=$(jq -nc --rawfile program "$repo_root/demos/matrix_microscope.mlpl" '{program: $program}')

curl --fail --silent --no-buffer \
    --header "Authorization: Bearer $token" \
    --header 'Content-Type: application/json' \
    --data "$body" \
    "$base_url/v1/sessions/$session_id/eval_stream" >"$response_file"

events=$(sed -n 's/^event: *//p' "$response_file" | tr '\n' ' ')
[ "$events" = "ready frame frame frame frame frame frame frame frame done " ] || {
    echo "unexpected matrix SSE event order: $events" >&2
    exit 1
}

actual=$(sed -n 's/^data: *//p' "$response_file" | jq -s \
  --arg schema "sw-ml-study.ml-microscope-recording" \
  --arg lesson "matrix-multiplication" \
  --slurpfile fixture "$fixture" '
    [ .[] | select(.name != null) | {step, observation: {name, shape, values}} ]
    | group_by(.step)
    | map({step: .[0].step, observations: map(.observation)})
    | {schema: $schema, version: 0, lesson: $lesson, budgets: $fixture[0].budgets, frames: .}
  ')

if [ "$(printf '%s' "$actual" | jq -S -c .)" != "$(jq -S -c . "$fixture")" ]; then
    echo "live matrix recording differs from committed Yew fixture" >&2
    exit 1
fi

echo "PASS live matrix SSE recording matches the Yew integration fixture"
