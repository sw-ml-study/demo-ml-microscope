#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
fixture="$repo_root/fixtures/yew/linear-regression-run-v0.json"
actual=$($repo_root/scripts/capture-regression-recording)

if [ "$(printf '%s' "$actual" | jq -S -c .)" != "$(jq -S -c . "$fixture")" ]; then
    echo "live regression recording differs from committed Yew fixture" >&2
    exit 1
fi

echo "PASS live regression SSE recording matches the Yew integration fixture"
