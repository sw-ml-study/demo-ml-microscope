#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mlpl=$($repo_root/scripts/select-mlpl)
runner=$($repo_root/scripts/select-mlplunit)

if [ "$#" -gt 0 ]; then
    exec "$runner" --mlpl "$mlpl" --config "$repo_root/mlplunit.conf" "$@"
fi
exec "$runner" --mlpl "$mlpl" --config "$repo_root/mlplunit.conf"
